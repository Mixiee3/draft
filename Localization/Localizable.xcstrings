    "%@ doesn't have this permission, so it can't be applied. Allow it in Settings › Agents, or reject it.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ toto oprávnění nemá, takže změnu nelze použít. Povolte ho v Nastavení › Agenti, nebo návrh odmítněte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat diese Berechtigung nicht, daher kann die Änderung nicht angewendet werden. Erlaube sie unter Einstellungen › Agenten oder lehne sie ab."
