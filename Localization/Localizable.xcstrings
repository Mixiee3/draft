    "%lld backups, %@. They go to the macOS Trash, so you can still put them back from Finder.": {
      "localizations": {
        "cs": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld zálohy, %@. Přesunou se do koše macOS, takže je můžete z Finderu vrátit."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld záloha, %@. Přesune se do koše macOS, takže ji můžete z Finderu vrátit."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld záloh, %@. Přesunou se do koše macOS, takže je můžete z Finderu vrátit."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Sicherung, %@. Sie kommt in den macOS-Papierkorb und lässt sich im Finder zurücklegen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Sicherungen, %@. Sie kommen in den macOS-Papierkorb und lassen sich im Finder zurücklegen."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld backup, %@. It goes to the macOS Trash, so you can still put it back from Finder."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld backups, %@. They go to the macOS Trash, so you can still put them back from Finder."
                }
              }
            }
          }
        }
      }
    },
    "%lld block ids are used twice (%@). Links to those blocks can land on the wrong one.": {
