<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime exceptions Draft needs, and nothing else.
     audio-input: Assistant dictation (only while the microphone button is held).
     calendars: events next to daily notes (only after the person turns it on).
     No JIT, no unsigned executable memory, no Apple Events, no sandbox exceptions. -->
<plist version="1.0"><dict>
  <key>com.apple.security.device.audio-input</key><true/>
  <key>com.apple.security.personal-information.calendars</key><true/>
</dict></plist>
